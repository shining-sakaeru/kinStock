{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://64.110.107.153:8000/api/$1"
    },
    {
      "source": "/docs",
      "destination": "http://64.110.107.153:8000/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "http://64.110.107.153:8000/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
